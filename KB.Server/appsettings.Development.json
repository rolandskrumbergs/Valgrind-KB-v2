{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "KB": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "HH:mm:ss ",
        "IncludeScopes": true,
        "SingleLine": true
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=KB;Username=postgres;Password=admin"
  },
  "AI": {
    "AzureBlobStorage": {
      "ConnectionString": "UseDevelopmentStorage=true"
    }
  }
}
