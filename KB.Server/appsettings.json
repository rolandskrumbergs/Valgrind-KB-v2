{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=KB;Username=postgres;Password=admin"
  },
  "JwtSettings": {
    "SecretKey": "** USE USER SECRETS FOR DEVELOPMENT **",
    "Issuer": "KB.API",
    "Audience": "KB.Client",
    "AccessTokenExpirationMinutes": "30",
    "RefreshTokenExpirationDays": "30"
  },
  "AI": {
    "DefaultModel": "gpt-4o",
    "MaxAgenticLoopSteps": 5,
    "MaxConversationHistoryMessages": 20,
    "AzureOpenAi": {
      "Endpoint": "https://kb-open-ai-shared.openai.azure.com/",
      "ChatDeployment": "gpt-4.1",
      "EvaluationDeployment": "gpt-4.1",
      "EmbeddingDeployment": "text-embedding-3-small"
    },
    "AzureBlobStorage": {
      "ConnectionString": "** USE USER SECRETS **"
    },
    "ConfidenceDefaults": {
      "MinRelevanceScore": 0.7,
      "MinRelevanceChunksRequired": 2,
      "HighConfidenceScore": 0.85,
      "HighConfidenceChunksRequired": 1,
      "ChunkEvaluationMinScore": 5,
      "JudgeMinGroundedness": 3.0,
      "JudgeMinRelevance": 3.0,
      "JudgeMinCoherence": 3.0,
      "JudgeMinFactualAccuracy": 3.0,
      "MaxUnverifiedCitationRatio": 0.3
    }
  }
}
